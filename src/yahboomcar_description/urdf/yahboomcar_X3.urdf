<?xml version="1.0" encoding="utf-8"?>
<robot name="yahboomcar">
    <link name="base_footprint"/>
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.025 0.008"/>
            </geometry>
            <material name="purple">
                <color rgba="0.5 0 0.5 1"/>
            </material>
        </visual>
    </link>
    
    <link name="base_link">
        <inertial>
            <origin xyz="0.005 0.0001 -0.012" rpy="0 0 0"/>
            <mass value="0.486"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.23 0.15 0.08"/>
            </geometry>
            <material name="green">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.23 0.15 0.08"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    </joint>
    
    <joint name="base_imu" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.0565 0.015 0.11" rpy="0 3.1415 1.5707"/>
    </joint>
    
    <!-- Wheels -->
    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="front_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.08 -0.087 -0.0495" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="front_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.08 0.087 -0.0495" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="back_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="back_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_wheel"/>
        <origin xyz="-0.08 -0.087 -0.0495" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="back_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="back_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_wheel"/>
        <origin xyz="-0.08 0.087 -0.0495" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <!-- Laser -->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
            <material name="red">
                <color rgba="0.8 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.039 0.0 0.082" rpy="0 0 3.14159"/>  <!-- measured 2026-06-24: lidar 164mm above floor, 39mm fwd of base_link, rear-mount -->
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>
    
    <!-- Camera -->
    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.03 0.1 0.03"/>
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.2 0.8 1"/>
            </material>
        </visual>
    </link>
    
    <!-- Camera tilt: servo pivot -> revolute (STS3215) -> 45mm lever arm -> camera_link.
         Fed by /camera_tilt_joint_state from camera_tilt_node (counts->rad about level=2015). -->
    <link name="camera_tilt_pivot"/>
    <joint name="camera_pivot_joint" type="fixed">
        <origin xyz="0.089 0.008 0.031" rpy="0 0 0"/>  <!-- measured 2026-06-24: pivot 113mm floor, 8mm left; = lens(90mm fwd of lidar) - 40mm arm -->
        <parent link="base_link"/>
        <child link="camera_tilt_pivot"/>
    </joint>

    <link name="camera_tilt_link"/>
    <joint name="camera_tilt_joint" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_tilt_pivot"/>
        <child link="camera_tilt_link"/>
        <axis xyz="0 1 0"/>  <!-- sign fixed 2026-06-24: down-tilt now reads down in TF (was inverted, marking floor as obstacles) -->
        <limit lower="-0.401" upper="1.204" effort="10.0" velocity="5.0"/>
    </joint>

    <joint name="camera_arm_joint" type="fixed">
        <origin xyz="0.040 0 0" rpy="0 0 0"/>  <!-- measured 2026-06-24: 40mm pivot->depth-sensor arm (lens lands 90mm fwd of lidar) -->
        <parent link="camera_tilt_link"/>
        <child link="camera_link"/>
    </joint>

    <!-- Bridge URDF camera_link -> realsense driver root frame. The driver
         roots its tree at 'realsense_camera_realsense_camera_link' (camera_name
         + base_frame, doubled prefix). Identity transform: camera_link IS that
         physical point; the driver's static TFs offset to each sensor. WITHOUT
         THIS the depth cloud frames are disconnected from base_footprint and the
         pointcloud height filter cannot place points -> floor marked as obstacles. -->
    <joint name="camera_link_to_realsense" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="camera_link"/>
        <child link="realsense_camera_realsense_camera_link"/>
    </joint>
</robot> 