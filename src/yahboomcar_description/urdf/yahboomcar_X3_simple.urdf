<?xml version="1.0" encoding="utf-8"?>
<robot name="yahboomcar">
    <link name="base_footprint"/>
    <link name="imu_link"/>
    
    <link name="base_link">
        <inertial>
            <origin xyz="0.005 0.0001 -0.012" rpy="0 0 0"/>
            <mass value="0.486"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.15 0.08"/>
            </geometry>
            <material name="green">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.15 0.08"/>
            </geometry>
        </collision>
    </link>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    </joint>
    
    <joint name="base_imu" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.06 0.01 0.01" rpy="0 3.1415 1.5707"/>
    </joint>
    
    <!-- Wheels -->
    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.033" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="front_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.06 -0.0775 -0.0165" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.033" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="front_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.06 0.0775 -0.0165" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="back_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.033" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="back_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_wheel"/>
        <origin xyz="-0.06 -0.0775 -0.0165" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="back_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.033" length="0.026"/>
            </geometry>
            <material name="black">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="back_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_wheel"/>
        <origin xyz="-0.06 0.0775 -0.0165" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
    <!-- Laser -->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.04"/>
            </geometry>
            <material name="red">
                <color rgba="0.8 0.2 0.2 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.0435 0.0001 0.11" rpy="0 0 3.14159"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>
    
    <!-- Camera -->
    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.03 0.1 0.03"/>
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.2 0.8 1"/>
            </material>
        </visual>
    </link>
    
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.12 0.0 0.0285" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>
</robot> 