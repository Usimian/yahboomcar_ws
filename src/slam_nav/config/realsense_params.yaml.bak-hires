enable_color: true
enable_depth: true
enable_infra1: false
enable_infra2: false
enable_gyro: true       # camera IMU for depth-map per-frame tilt
enable_accel: true
                        # Robot navigates on the base IMU via EKF, never the camera IMU.
unite_imu_method: 2
depth_module.depth_profile: "480x270x15"
rgb_camera.color_profile: "424x240x15"
align_depth.enable: true
publish_tf: true
tf_publish_rate: 0.0
base_frame_id: "realsense_camera_link"
clip_distance: 5.0
# NOTE: The pointcloud__neon_.* names below are correct on this robot (ARM CPU
# with NEON). librealsense 2.56.3+ added a NEON-optimized pointcloud filter whose
# name is not normalized by rs2_to_ros() in realsense-ros, so the ROS param
# namespace becomes "pointcloud__neon_" instead of "pointcloud". Launch-time
# warnings claiming these params are unsupported list the x86/CUDA names and are
# misleading on this build. Do not "fix" them.
# Upstream Q&A: https://github.com/realsenseai/realsense-ros/issues/3397
# Root cause: realsense2_camera/src/ros_utils.cpp rs2_to_ros() is missing a
#             {"Pointcloud (NEON)", "Pointcloud"} map entry as of v4.57.7.
pointcloud__neon_.enable: true
pointcloud__neon_.allow_no_texture_points: true
pointcloud__neon_.stream_filter: 2
wait_for_device_timeout: -1.0
reconnect_timeout: -1.0
depth_module.enable_auto_exposure: true
rgb_camera.enable_auto_exposure: true
rgb_camera.power_line_frequency: 2
