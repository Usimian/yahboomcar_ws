# Odometry Scaling Parameters for Base Node
# These parameters correct odometry drift and sensor inaccuracies

/**:
  ros__parameters:
    # Odometry scaling factors to correct position estimation errors
    # due to wheel slip, carpet friction, encoder inaccuracies, etc.
    linear_scale_x: 1.310    # Linear X odometry scaling factor (0.760m actual / 0.580m vel_raw)
    linear_scale_y: 1.310    # Linear Y odometry scaling factor (assuming same for Y)
    angular_scale: 1.000       # Angular Z odometry scaling factor
    
    # Frame names for TF publishing
    odom_frame: "odom"
    base_footprint_frame: "base_footprint"
    
    # TF publishing control
    pub_odom_tf: false       # Whether to publish odom->base_footprint transform
